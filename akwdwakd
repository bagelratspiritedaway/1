function Section:AddButton(options: { [string]: any })
	local list = options.Buttons or { options }

	local container = Add("Frame", {
		Parent = self.Content,
		Name = "Buttons",
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, 32),
		BorderSizePixel = 0,
		LayoutOrder = self:_Order(),
	})
	List(container, {
		FillDirection = FD.Horizontal,
		VerticalAlignment = VFA.Center,
		HorizontalAlignment = HFA.Center,
		HorizontalFlex = UFA.Fill,
		Padding = UD(0, 8),
	})

	local built = {}
	for index, entry in ipairs(list) do
		local accent = entry.Style == "Accent"

		local button = Add("TextButton", {
			Parent = container,
			Name = "Button",
			Text = "",
			AutoButtonColor = false,
			Size = UD2(1, 0, 0, 32),
			LayoutOrder = index,
			BorderSizePixel = 0,
			ClipsDescendants = true,
		})
		Corner(button, 8)

		local stroke
		if accent then
			AccentFill(button)
		else
			Bind(button, { BackgroundColor3 = "Element" })
			stroke = Stroke(button, "Border")
		end

		local overlay = Overlay(button, 8)
		local label = Text(button, {
			Name = "Label",
			Text = entry.Title or entry.Name or "Button",
			TextColor3 = accent and WHITE or nil,
			Size = UFS(1, 1),
			TextTruncate = ETT.AtEnd,
			ZIndex = 3,
		})

		Hover(button, function(hovering)
			Tween(overlay, Anim.Base, { BackgroundTransparency = hovering and 0.93 or 1 })
			if stroke then
				Tween(stroke, Anim.Base, { Color = hovering and Callisto.Theme.Accent or Callisto.Theme.Border })
			end
		end)
		Connect(button.MouseButton1Down, function()
			Tween(overlay, Anim.Fast, { BackgroundTransparency = 0.86 })
		end)
		Connect(button.MouseButton1Up, function()
			Tween(overlay, Anim.Base, { BackgroundTransparency = 0.93 })
		end)

		Connect(button.MouseButton1Click, function()
			if entry.Callback then
				task.spawn(entry.Callback)
			end
		end)

		TIS(built, { Instance = button, Label = label })
	end

	return { Instance = container, Buttons = built }
end

function Section:AddToggle(options: { [string]: any })
	local row, _, right = self:_Row(options.Title or "Toggle", options.Description)
	local flag = options.Flag

	local function fire(state: boolean)
		if flag then
			Callisto.Flags[flag] = state
		end
		if options.Callback then
			options.Callback(state)
		end
	end

	local control
	if options.Style == "Checkbox" then
		control = MakeCheckbox(right, options.Default or false, fire)
	else
		control = MakeToggle(right, options.Default or false, fire)
	end

	if flag then
		Callisto.Flags[flag] = options.Default or false
	end

	control.Row = row
	return control
end

function Section:AddCheckbox(options: { [string]: any })
	options.Style = "Checkbox"
	return self:AddToggle(options)
end

