		Parent = alphaBar,
		Name = "Fill",
		Size = UFS(1, 1),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
	})
	Round(alphaFill)
	Add("UIGradient", { Parent = alphaFill, Transparency = NS({ NSK(0, 1), NSK(1, 0) }) })
	local alphaKnob = Knob(alphaBar, 14)

	-- preview + hex
	local preview = Add("Frame", {
		Parent = panel,
		Name = "Preview",
		Position = UD2(0, 0, 0, 160),
		Size = UFO(24, 24),
		BorderSizePixel = 0,
	})
	Corner(preview, 6)
	Stroke(preview, "Border")

	local hexBox = Add("Frame", {
		Parent = panel,
		Name = "HexBox",
		Position = UD2(0, 32, 0, 160),
		Size = UD2(1, -32, 0, 24),
		BorderSizePixel = 0,
	})
	Bind(hexBox, { BackgroundColor3 = "Element" })
	Corner(hexBox, 6)
	local hexStroke = Stroke(hexBox, "Border")

	local hexInput = Text(hexBox, {
		ClassName = "TextBox",
		Name = "Hex",
		Size = UFS(1, 1),
		Text = "",
		ClearTextOnFocus = false,
		TextSize = 12,
		PlaceholderText = "#FFFFFF",
	})

	local function render(silent: boolean?)
		local color = HSV(hue, saturation, value)

		swatch.BackgroundColor3 = color
		swatch.BackgroundTransparency = alpha
		preview.BackgroundColor3 = color
		preview.BackgroundTransparency = alpha
		alphaFill.BackgroundColor3 = color
		svGradient.Color = CS({ CSK(0, WHITE), CSK(1, HSV(hue, 1, 1)) })

		svKnob.Position = UD2(saturation, 0, 1 - value, 0)
		svKnob.BackgroundColor3 = color
		hueKnob.Position = UD2(hue, 0, 0.5, 0)
		hueKnob.BackgroundColor3 = HSV(hue, 1, 1)
		alphaKnob.Position = UD2(1 - alpha, 0, 0.5, 0)
		alphaKnob.BackgroundColor3 = color

		if not hexInput:IsFocused() then
			hexInput.Text = "#" .. color:ToHex():upper()
		end

		if not silent then
			task.spawn(callback, color, alpha)
		end
	end

	local function BindTrack(track: GuiObject, apply: (Vector2) -> ())
		local dragging = false

		local function update(position: Vector3 | Vector2)
			local absolutePosition = track.AbsolutePosition
			local absoluteSize = track.AbsoluteSize
			apply(V2(
				MC((position.X - absolutePosition.X) / absoluteSize.X, 0, 1),
				MC((position.Y - absolutePosition.Y) / absoluteSize.Y, 0, 1)
			))
		end

		Connect(track.InputBegan, function(input)
			if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
				dragging = true
				update(input.Position)
			end
		end)
		Connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
				dragging = false
			end
		end)
		Connect(UserInputService.InputChanged, function(input)
			if dragging and (input.UserInputType == UIT.MouseMovement or input.UserInputType == UIT.Touch) then
				update(input.Position)
			end
		end)
	end

	BindTrack(hueBar, function(position)
		hue = position.X
		render()
	end)
	BindTrack(alphaBar, function(position)
		alpha = 1 - position.X
		render()
	end)
	BindTrack(sv, function(position)
		saturation = position.X
		value = 1 - position.Y
		render()
	end)

	Connect(hexInput.Focused, function()
		Tween(hexStroke, Anim.Base, { Color = Callisto.Theme.Accent })
	end)
	Connect(hexInput.FocusLost, function()
		Tween(hexStroke, Anim.Base, { Color = Callisto.Theme.Border })
		local ok, color = pcall(Color3.fromHex, hexInput.Text)
		if ok and color then
			hue, saturation, value = color:ToHSV()
		end
		render()
	end)

	local controller = Floating(window, swatch, panel, function()
		return 212
	end, function()
		return 204
	end, true)

	Connect(swatch.MouseButton1Click, controller.Toggle)

	render(true)

	return {
		Panel = panel,
		Close = function()
			controller.SetOpen(false)
		end,
		Get = function()
			return HSV(hue, saturation, value), alpha
		end,
		Set = function(_, color: Color3, newAlpha: number?)
			hue, saturation, value = color:ToHSV()
			alpha = newAlpha or alpha
			render()
		end,
	}
end

