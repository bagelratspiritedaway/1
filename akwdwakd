local Section = {}
Section.__index = Section

function Section:_Order(): number
	self._order = (self._order or 0) + 1
	return self._order
end

-- A horizontal row: title (+ optional description) on the left, controls on the right
function Section:_Row(title: string, description: string?)
	local row = Add("Frame", {
		Parent = self.Content,
		Name = "Row",
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, 28),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
		LayoutOrder = self:_Order(),
	})

	local left = Add("Frame", {
		Parent = row,
		Name = "Left",
		BackgroundTransparency = 1,
		Size = UD2(1, -76, 0, 28),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
	})
	List(left, { Padding = UD(0, 2) })

	local label = Text(left, {
		Name = "Title",
		LayoutOrder = 1,
		Text = title,
		Size = UD2(1, 0, 0, description and 16 or 28),
		AutomaticSize = description and AT.Y or AT.None,
		TextWrapped = true,
		TextXAlignment = TXA.Left,
	})

	local desc
	if description then
		Padding(left, 6, 6, 0, 0)
		desc = Text(left, {
			Name = "Description",
			LayoutOrder = 2,
			Text = description,
			ColorKey = "SubText",
			TextSize = 12,
			Size = UD2(1, 0, 0, 14),
			AutomaticSize = AT.Y,
			TextWrapped = true,
			TextXAlignment = TXA.Left,
			TextYAlignment = TYA.Top,
		})
	end

	local right = Add("Frame", {
		Parent = row,
		Name = "Right",
		AnchorPoint = V2(1, 0),
		Position = UD2(1, 0, 0, 0),
		Size = UD2(0, 0, 0, 28),
		AutomaticSize = AT.X,
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	List(right, {
		FillDirection = FD.Horizontal,
		VerticalAlignment = VFA.Center,
		HorizontalAlignment = HFA.Right,
		Padding = UD(0, 8),
	})

	return row, left, right, label, desc
end

-- A stacked block: small caption on top, control below
function Section:_Stack(name: string, title: string?)
	local container = Add("Frame", {
		Parent = self.Content,
		Name = name,
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, 0),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
		LayoutOrder = self:_Order(),
	})
	List(container, { Padding = UD(0, 6) })

	local caption
	if title then
		caption = Text(container, {
			Name = "Title",
			LayoutOrder = 1,
			Text = title,
			ColorKey = "SubText",
			TextSize = 12,
			Size = UD2(1, 0, 0, 14),
			TextXAlignment = TXA.Left,
		})
	end
	return container, caption
end

function Section:AddLabel(options: { [string]: any } | string)
