--=============================================================================
-- Theme
--=============================================================================

local DefaultTheme = {
	Background = RGB(12, 13, 16),
	Sidebar = RGB(16, 17, 21),
	Surface = RGB(21, 23, 28),
	Element = RGB(30, 32, 40),
	Border = RGB(40, 43, 52),
	Accent = RGB(139, 92, 246),
	AccentAlt = RGB(96, 140, 255),
	Text = RGB(236, 238, 245),
	SubText = RGB(132, 138, 156),
}

Callisto.Theme = table.clone(DefaultTheme)

local ColorRegistry: { [Instance]: { [string]: string } } = {}
local GradientRegistry: { [UIGradient]: { { any } } } = {}
local ThemeTransition: RBXScriptConnection? = nil

local function Bind(instance: Instance, map: { [string]: string })
	local existing = ColorRegistry[instance]
	if existing then
		for property, key in next, map do
			existing[property] = key
		end
	else
		ColorRegistry[instance] = table.clone(map)
	end
	for property, key in next, map do
		pcall(function()
			(instance :: any)[property] = Callisto.Theme[key]
		end)
	end
end

local function BindGradient(gradient: UIGradient, stops: { { any } })
	GradientRegistry[gradient] = stops
	local keypoints = {}
	for _, stop in next, stops do
		TIS(keypoints, CSK(stop[1], Callisto.Theme[stop[2]]))
	end
	gradient.Color = CS(keypoints)
end

local function PaintTheme(alpha: number, previous: { [string]: Color3 })
	for instance, map in next, ColorRegistry do
		if not instance.Parent then
			ColorRegistry[instance] = nil
			continue
		end
		for property, key in next, map do
			pcall(function()
				(instance :: any)[property] = previous[key]:Lerp(Callisto.Theme[key], alpha)
			end)
		end
	end

	for gradient, stops in next, GradientRegistry do
		if not gradient.Parent then
			GradientRegistry[gradient] = nil
			continue
		end
		local keypoints = {}
		for _, stop in next, stops do
			TIS(keypoints, CSK(stop[1], previous[stop[2]]:Lerp(Callisto.Theme[stop[2]], alpha)))
		end
		gradient.Color = CS(keypoints)
	end
end

function Callisto:SetTheme(theme: { [string]: Color3 }, animate: boolean?)
	local previous = table.clone(self.Theme)

	for key, color in next, theme do
		if self.Theme[key] ~= nil then
			self.Theme[key] = color
		end
	end

	-- derive a matching second accent colour when only Accent was given
	if theme.Accent and not theme.AccentAlt then
		local h, s, v = theme.Accent:ToHSV()
		self.Theme.AccentAlt = HSV((h + 0.08) % 1, s * 0.85, math.min(v + 0.05, 1))
	end

	if ThemeTransition then
		ThemeTransition:Disconnect()
		ThemeTransition = nil
	end

	if animate == false then
		PaintTheme(1, previous)
		return
	end

	local elapsed = 0
	ThemeTransition = RunService.RenderStepped:Connect(function(dt)
		elapsed += dt
		local progress = MC(elapsed / 0.25, 0, 1)
		PaintTheme(1 - (1 - progress) ^ 3, previous)
		if progress >= 1 and ThemeTransition then
			ThemeTransition:Disconnect()
			ThemeTransition = nil
		end
	end)
end

function Callisto:ResetTheme(animate: boolean?)
	self:SetTheme(table.clone(DefaultTheme), animate)
end

--=============================================================================
-- Utilities
--=============================================================================

local function Add(class: string, properties: { [string]: any }?): any
	local instance = Instance.new(class)
	local parent
	if properties then
		for key, value in next, properties do
			if key == "Parent" then
				parent = value
			else
				local ok, err = pcall(function()
					(instance :: any)[key] = value
				end)
				if not ok then
					warn(err)
				end
			end
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

local Anim = {
	Fast = TI(0.12, ES.Quad, ED.Out),
	Base = TI(0.2, ES.Quad, ED.Out),
	Slow = TI(0.32, ES.Quart, ED.Out),
	Spring = TI(0.4, ES.Back, ED.Out),
}

local function Tween(instance: Instance, info: TweenInfo, goal: { [string]: any }): Tween
	local tween = TweenService:Create(instance, info, goal)
	tween:Play()
	return tween
end

local function Connect(signal: RBXScriptSignal, callback)
	local connection = signal:Connect(callback)
	TIS(Callisto.Connections, connection)
	return connection
end

local function Hover(object: GuiObject, callback: (boolean) -> ())
	Connect(object.MouseEnter, function()
		callback(true)
	end)
	Connect(object.MouseLeave, function()
		callback(false)
	end)
end

local function Face(weight: Enum.FontWeight?)
	return FN(FONT, weight or FW.Medium, FS.Normal)
end

local function Corner(parent: Instance, radius: number)
	return Add("UICorner", { Parent = parent, CornerRadius = UD(0, radius) })
end

local function Round(parent: Instance)
	return Add("UICorner", { Parent = parent, CornerRadius = UD(1, 0) })
end

local function Stroke(parent: Instance, key: string?, thickness: number?)
	local stroke = Add("UIStroke", {
		Parent = parent,
		ApplyStrokeMode = ASM.Border,
		BorderStrokePosition = BSP.Inner,
		Thickness = thickness or 1,
	})
	Bind(stroke, { Color = key or "Border" })
	return stroke
end

local function Padding(parent: Instance, top: number?, bottom: number?, left: number?, right: number?)
	return Add("UIPadding", {
		Parent = parent,
		PaddingTop = UD(0, top or 0),
		PaddingBottom = UD(0, bottom or 0),
		PaddingLeft = UD(0, left or 0),
		PaddingRight = UD(0, right or 0),
	})
end

local function List(parent: Instance, properties: { [string]: any }?)
	local props = properties or {}
	props.Parent = parent
	props.SortOrder = props.SortOrder or SO.LayoutOrder
	return Add("UIListLayout", props)
end

-- Solid-white frame with an accent gradient on top. The frame's own
-- BackgroundTransparency can still be tweened to fade the fill in/out.
local function AccentFill(frame: Frame | TextButton)
	frame.BackgroundColor3 = WHITE
	local gradient = Add("UIGradient", { Parent = frame, Rotation = 0 })
	BindGradient(gradient, { { 0, "Accent" }, { 1, "AccentAlt" } })
	return gradient
end

local function Text(parent: Instance, properties: { [string]: any }): any
	local props = properties
	props.Parent = parent
	props.FontFace = props.FontFace or Face(FW.Medium)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.TextSize = props.TextSize or 13
	props.BorderSizePixel = 0
	props.RichText = true

	local class = props.ClassName or "TextLabel"
	props.ClassName = nil

	local colorKey = props.ColorKey or "Text"
	props.ColorKey = nil

	local color = props.TextColor3
	props.TextColor3 = nil

	local label = Add(class, props)
	if typeof(color) == "Color3" then
		label.TextColor3 = color
	else
		Bind(label, { TextColor3 = colorKey })
	end
	return label
end

-- translucent white layer used for hover / press feedback (theme independent)
local function Overlay(parent: GuiObject, radius: number)
	local overlay = Add("Frame", {
		Parent = parent,
		Name = "Overlay",
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		BorderSizePixel = 0,
	})
	Corner(overlay, radius)
	return overlay
end

local function GetRoot(): Instance
	local existing = Callisto._root
	if existing and existing.Parent then
		return existing
	end

	local parent
	local ok, hui = pcall(function()
		return ((getfenv() :: any).gethui)()
	end)
	if ok and hui then
		parent = hui
	elseif RunService:IsStudio() then
		parent = LocalPlayer:WaitForChild("PlayerGui")
	else
		local success, core = pcall(function()
			return game:GetService("CoreGui")
		end)
		parent = (success and core) or LocalPlayer:WaitForChild("PlayerGui")
	end

	Callisto._root = Add("Folder", { Parent = parent, Name = "Callisto" })
	return Callisto._root
end

local function InsideBounds(mouse: Vector2, object: GuiObject): boolean
	local topLeft = object.AbsolutePosition
	local bottomRight = topLeft + object.AbsoluteSize
	return mouse.X >= topLeft.X and mouse.X <= bottomRight.X and mouse.Y >= topLeft.Y and mouse.Y <= bottomRight.Y
end

local function MakeDraggable(handle: GuiObject, target: GuiObject)
	local dragging, dragStart, startPosition = false, Vector3.zero, UD2()
	local goal = target.Position
	local settling = false

	Connect(handle.InputBegan, function(input)
		if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
			dragging = true
			settling = true
			dragStart = input.Position
			startPosition = target.Position
			goal = startPosition

			local connection
			connection = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					connection:Disconnect()
				end
			end)
		end
	end)

	Connect(UserInputService.InputChanged, function(input)
		if not dragging then
			return
		end
		if input.UserInputType ~= UIT.MouseMovement and input.UserInputType ~= UIT.Touch then
			return
		end
		local delta = input.Position - dragStart
		goal = UD2(
			startPosition.X.Scale,
			startPosition.X.Offset + delta.X,
			startPosition.Y.Scale,
			startPosition.Y.Offset + delta.Y
		)
	end)

	Connect(RunService.RenderStepped, function(dt)
		if not settling then
			return
		end
		local position = target.Position
		local settled = not dragging
			and math.abs(goal.X.Offset - position.X.Offset) < 0.5
			and math.abs(goal.Y.Offset - position.Y.Offset) < 0.5
		if settled then
			target.Position = goal
			settling = false
			return
		end
		target.Position = position:Lerp(goal, MC(dt * 22, 0, 1))
	end)
end

local function MakeResizable(handle: GuiButton, target: GuiObject, minimum: Vector2)
	local resizing, startPosition, startSize = false, Vector3.zero, V2()

	Connect(handle.InputBegan, function(input)
		if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
			resizing = true
			startPosition = input.Position
			startSize = target.AbsoluteSize

			local connection
			connection = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
					connection:Disconnect()
				end
			end)
		end
	end)

	Connect(UserInputService.InputChanged, function(input)
		if not resizing then
			return
		end
		if input.UserInputType ~= UIT.MouseMovement and input.UserInputType ~= UIT.Touch then
			return
		end
		local delta = input.Position - startPosition
		target.Size = UFO(
			math.max(minimum.X, MR(startSize.X + delta.X)),
			math.max(minimum.Y, MR(startSize.Y + delta.Y))
		)
	end)
end

--=============================================================================
-- Floating popups (dropdowns / colorpicker)
--=============================================================================

local function Popup(externals: Instance, name: string)
	local popup = Add("CanvasGroup", {
		Parent = externals,
		Name = name,
		Visible = false,
		GroupTransparency = 1,
		BorderSizePixel = 0,
		Size = UFO(0, 0),
	})
	Bind(popup, { BackgroundColor3 = "Surface" })
	Corner(popup, 10)
	Stroke(popup, "Border")
	return popup
end

-- Handles open/close animation, placement (flips above if there is no room),
-- following the anchor while open, and click-outside closing.
local function Floating(window, anchor: GuiObject, popup: GuiObject, getWidth, getHeight, alignRight: boolean?, onToggle)
	local controller = { Open = false }
	local follow: RBXScriptConnection? = nil
	local height = 0

	local function place()
		local externals = window.Externals
		local screen = externals.AbsoluteSize
		local origin = externals.AbsolutePosition
		local anchorPos, anchorSize = anchor.AbsolutePosition, anchor.AbsoluteSize
		local width = popup.Size.X.Offset

		local x = alignRight and (anchorPos.X + anchorSize.X - width) or anchorPos.X
		x = MC(x, 8, math.max(screen.X - width - 8, 8))

		local y = anchorPos.Y + anchorSize.Y + 6
		if y + height > screen.Y - 8 then
			y = math.max(anchorPos.Y - height - 6, 8)
		end

		popup.Position = UFO(MR(x - origin.X), MR(y - origin.Y))
	end

	function controller.SetOpen(state: boolean)
		if controller.Open == state then
			return
		end
		controller.Open = state

		if state then
			window:CloseFloating(controller)
			height = getHeight()
			local width = getWidth()
			popup.Size = UFO(width, 0)
			popup.GroupTransparency = 1
			popup.Visible = true
			place()
			Tween(popup, Anim.Slow, { Size = UFO(width, height), GroupTransparency = 0 })
			follow = RunService.RenderStepped:Connect(place)
		else
			if follow then
				follow:Disconnect()
				follow = nil
			end
			local tween = Tween(popup, Anim.Base, {
				GroupTransparency = 1,
				Size = UFO(popup.Size.X.Offset, 0),
			})
			tween.Completed:Once(function()
				if not controller.Open then
					popup.Visible = false
				end
			end)
		end

		if onToggle then
			onToggle(state)
		end
	end

	function controller.Toggle()
		controller.SetOpen(not controller.Open)
	end

	Connect(UserInputService.InputBegan, function(input)
		if not controller.Open then
			return
		end
		if input.UserInputType ~= UIT.MouseButton1 and input.UserInputType ~= UIT.Touch then
			return
		end
		local mouse = V2(input.Position.X, input.Position.Y)
		if not InsideBounds(mouse, popup) and not InsideBounds(mouse, anchor) then
			controller.SetOpen(false)
		end
	end)

	TIS(window.Floaters, controller)
	return controller
end

