-- Callisto:Notify({ Title = "", Content = "", Duration = 4, Type = "Info"|"Success"|"Warning"|"Error" })
-- or Callisto:Notify("Title", "Content", 4)
function Callisto:Notify(options: any, content: string?, duration: number?)
	local opts = type(options) == "table" and options or { Title = options, Content = content, Duration = duration }
	local lifetime = opts.Duration or 4
	local kind = tostring(opts.Type or "Info"):lower()

	local holder = GetNotifier()

	local wrapper = Add("Frame", {
		Parent = holder,
		Name = "Notification",
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, 0),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
	})

	local card = Add("CanvasGroup", {
		Parent = wrapper,
		Name = "Card",
		GroupTransparency = 1,
		Position = UFO(40, 0),
		Size = UD2(1, 0, 0, 0),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
	})
	Bind(card, { BackgroundColor3 = "Surface" })
	Corner(card, 10)
	Stroke(card, "Border")
	List(card)

	local body = Add("Frame", {
		Parent = card,
		Name = "Body",
		LayoutOrder = 1,
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, 0),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
	})
	Padding(body, 12, 12, 14, 14)
	List(body, { Padding = UD(0, 3) })

	local colors = {
		success = RGB(74, 205, 128),
		warning = RGB(255, 184, 64),
		error = RGB(255, 92, 92),
	}
	local tint = colors[kind]

	local title = Text(body, {
		Name = "Title",
		LayoutOrder = 1,
		Text = opts.Title or "Notification",
		FontFace = Face(FW.Bold),
		TextColor3 = tint,
		ColorKey = "Text",
		Size = UD2(1, 0, 0, 16),
		AutomaticSize = AT.Y,
		TextWrapped = true,
		TextXAlignment = TXA.Left,
	})
	if opts.Content and opts.Content ~= "" then
		Text(body, {
			Name = "Content",
			LayoutOrder = 2,
			Text = opts.Content,
			ColorKey = "SubText",
			TextSize = 12,
			Size = UD2(1, 0, 0, 14),
			AutomaticSize = AT.Y,
			TextWrapped = true,
			TextXAlignment = TXA.Left,
			TextYAlignment = TYA.Top,
		})
	end

	local track = Add("Frame", {
		Parent = card,
		Name = "Timer",
		LayoutOrder = 2,
		Size = UD2(1, 0, 0, 2),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	local fill = Add("Frame", {
		Parent = track,
		Name = "Fill",
		Size = UD2(1, 0, 1, 0),
		BorderSizePixel = 0,
	})
	if tint then
		fill.BackgroundColor3 = tint
	else
		AccentFill(fill)
	end

	Tween(card, Anim.Slow, { Position = UFO(0, 0), GroupTransparency = 0 })
	Tween(fill, TI(lifetime, ES.Linear), { Size = UD2(0, 0, 1, 0) })

	task.delay(lifetime, function()
		if not card.Parent then
			return
		end
		local tween = Tween(card, Anim.Base, { Position = UFO(40, 0), GroupTransparency = 1 })
		tween.Completed:Once(function()
			wrapper:Destroy()
		end)
	end)

	return wrapper
end

