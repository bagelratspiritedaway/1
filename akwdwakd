		Parent = hueBar,
		Color = CS({
			CSK(0, RGB(255, 0, 0)),
			CSK(0.17, RGB(255, 255, 0)),
			CSK(0.33, RGB(0, 255, 0)),
			CSK(0.5, RGB(0, 255, 255)),
