function Callisto:CreateWindow(options: { [string]: any }?)
	local opts: { [string]: any } = options or {}
	local size = opts.Size or V2(680, 470)
	local titleText = opts.Title or "Callisto"

	local screenGui = Add("ScreenGui", {
		Parent = GetRoot(),
		Name = "Window",
		Enabled = true,
		ZIndexBehavior = ZIB.Sibling,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 999,
	})

	local canvas = Add("CanvasGroup", {
		Parent = screenGui,
		Name = "Canvas",
		AnchorPoint = V2(0, 0),
