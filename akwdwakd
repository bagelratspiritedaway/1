local KeybindBlacklist = {
	[EKC.Unknown] = true,
}

function Section:AddKeybind(options: { [string]: any })
	local row, _, right = self:_Row(options.Title or "Keybind", options.Description)
	local current: EnumItem? = options.Default
	local binding = false

	local box = Text(right, {
		ClassName = "TextButton",
		Name = "Keybind",
		LayoutOrder = 2,
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 0,
		Size = UFO(0, 22),
		AutomaticSize = AT.X,
		TextSize = 11,
		FontFace = Face(FW.SemiBold),
		ColorKey = "SubText",
	})
	Bind(box, { BackgroundColor3 = "Element" })
	Corner(box, 6)
	Padding(box, 0, 0, 10, 10)
	local stroke = Stroke(box, "Border")

	local function render()
		box.Text = binding and "..." or (current and current.Name:upper() or "NONE")
		Tween(box, Anim.Fast, { TextColor3 = binding and Callisto.Theme.Accent or Callisto.Theme.SubText })
		Tween(stroke, Anim.Fast, { Color = binding and Callisto.Theme.Accent or Callisto.Theme.Border })
	end

	Connect(box.MouseButton1Click, function()
		binding = true
		render()
	end)

	Hover(box, function(hovering)
		if binding then
			return
		end
		Tween(stroke, Anim.Fast, { Color = hovering and Callisto.Theme.Accent or Callisto.Theme.Border })
	end)

	Connect(UserInputService.InputBegan, function(input, processed)
		if binding then
			if input.UserInputType == UIT.Keyboard and not KeybindBlacklist[input.KeyCode] then
				if input.KeyCode == EKC.Backspace then
					current = nil
				elseif input.KeyCode ~= EKC.Escape then
					current = input.KeyCode
				end
				binding = false
				render()
				if options.Flag then
					Callisto.Flags[options.Flag] = current
				end
			end
			return
		end

		if processed or not current then
			return
		end
		if input.UserInputType == UIT.Keyboard and input.KeyCode == current and options.Callback then
			task.spawn(options.Callback, current)
		end
	end)

	render()

	return {
		Instance = row,
		Get = function()
			return current
		end,
		Set = function(_, key: EnumItem?)
			current = key
			render()
			if options.Flag then
				Callisto.Flags[options.Flag] = current
			end
		end,
	}
end

local function SliderLike(self, options: { [string]: any }, interactive: boolean)
	local minimum = options.Min or 0
	local maximum = options.Max or 100
	local decimals = options.Decimals or 0
	local suffix = options.Suffix or ""
	local value = MC(options.Default or minimum, minimum, maximum)

	local container = self:_Stack(interactive and "Slider" or "Progress")

	local top = Add("Frame", {
		Parent = container,
		Name = "Top",
		LayoutOrder = 1,
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, 18),
		BorderSizePixel = 0,
	})
	Text(top, {
		Name = "Title",
		Text = options.Title or (interactive and "Slider" or "Progress"),
		Size = UD2(1, -70, 1, 0),
		TextXAlignment = TXA.Left,
		TextTruncate = ETT.AtEnd,
	})
	local current = Text(top, {
		Name = "Value",
		Text = "",
		ColorKey = "SubText",
		TextSize = 12,
		AnchorPoint = V2(1, 0),
		Position = UD2(1, 0, 0, 0),
		Size = UD2(0, 70, 1, 0),
		TextXAlignment = TXA.Right,
	})

	local track = Add("TextButton", {
		Parent = container,
		Name = "Track",
		LayoutOrder = 2,
		Text = "",
		AutoButtonColor = false,
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, interactive and 16 or 8),
		BorderSizePixel = 0,
	})

	local bar = Add("Frame", {
		Parent = track,
		Name = "Bar",
		AnchorPoint = V2(0, 0.5),
		Position = UD2(0, 0, 0.5, 0),
		Size = UD2(1, 0, 0, interactive and 6 or 8),
		BorderSizePixel = 0,
	})
	Bind(bar, { BackgroundColor3 = "Element" })
	Round(bar)

	local fill = Add("Frame", {
		Parent = bar,
		Name = "Fill",
		Size = UD2(0, 0, 1, 0),
		BorderSizePixel = 0,
	})
	Round(fill)
	AccentFill(fill)

	local knob
	if interactive then
		knob = Add("Frame", {
			Parent = bar,
			Name = "Knob",
			AnchorPoint = V2(0.5, 0.5),
			Position = UD2(0, 0, 0.5, 0),
			Size = UFO(12, 12),
			BackgroundColor3 = WHITE,
			BorderSizePixel = 0,
			ZIndex = 3,
		})
		Round(knob)
		Add("UIStroke", { Parent = knob, Color = RGB(0, 0, 0), Transparency = 0.6, Thickness = 1 })
	end

	local function round(number: number): number
		local multiplier = 10 ^ decimals
		return MF(number * multiplier + 0.5) / multiplier
	end

	local function render(animate: boolean?)
		local progress = (value - minimum) / math.max(maximum - minimum, 1e-9)
		local info = animate and Anim.Base or TI(0)
		Tween(fill, info, { Size = UD2(progress, 0, 1, 0) })
		if knob then
			Tween(knob, info, { Position = UD2(progress, 0, 0.5, 0) })
		end
		current.Text = tostring(round(value)) .. suffix
	end

	local function set(newValue: number, silent: boolean?, animate: boolean?)
		value = MC(round(newValue), minimum, maximum)
		render(animate)
		if options.Flag then
			Callisto.Flags[options.Flag] = value
		end
		if options.Callback and not silent then
			task.spawn(options.Callback, value)
		end
	end

	if interactive then
		local dragging = false
		local function updateFromInput(position: Vector3 | Vector2)
			local progress = MC((position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
			set(minimum + (maximum - minimum) * progress)
		end

		Connect(track.InputBegan, function(input)
			if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
				dragging = true
				Tween(knob, Anim.Fast, { Size = UFO(16, 16) })
				updateFromInput(input.Position)
			end
		end)
		Connect(UserInputService.InputEnded, function(input)
			if dragging and (input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch) then
				dragging = false
				Tween(knob, Anim.Fast, { Size = UFO(12, 12) })
			end
		end)
		Connect(UserInputService.InputChanged, function(input)
			if dragging and (input.UserInputType == UIT.MouseMovement or input.UserInputType == UIT.Touch) then
				updateFromInput(input.Position)
			end
		end)
		Hover(track, function(hovering)
			if not dragging then
				Tween(knob, Anim.Fast, { Size = hovering and UFO(14, 14) or UFO(12, 12) })
			end
		end)
	end

	set(value, true)

	return {
		Instance = container,
		Get = function()
			return value
		end,
		Set = function(_, newValue: number)
			set(newValue, not interactive, true)
		end,
	}
end

