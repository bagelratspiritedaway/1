function Window:AddPage(name: string, icon: string?)
	self._tabOrder = (self._tabOrder or 0) + 1

	local frame = Add("CanvasGroup", {
		Parent = self.Pages,
		Name = name .. "Page",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		Visible = false,
		BorderSizePixel = 0,
	})

	local function column(side: string)
		local isRight = side == "Right"
		local scroller = Add("ScrollingFrame", {
			Parent = frame,
			Name = side,
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			AnchorPoint = V2(isRight and 1 or 0, 0),
			Position = UD2(isRight and 1 or 0, 0, 0, 0),
			Size = UD2(0.5, -6, 1, 0),
			CanvasSize = UFS(0, 0),
			AutomaticCanvasSize = AT.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			ScrollBarThickness = 2,
			ScrollBarImageTransparency = 0.3,
			ElasticBehavior = Enum.ElasticBehavior.Never,
			Selectable = false,
		})
		Bind(scroller, { ScrollBarImageColor3 = "Border" })
		Padding(scroller, 0, 2, 0, 6)
		List(scroller, { Padding = UD(0, 12) })
		return scroller
	end

	local left, right = column("Left"), column("Right")

	-- sidebar tab
	local button = Add("TextButton", {
		Parent = self.TabList,
		Name = name,
		Text = "",
		AutoButtonColor = false,
		Size = UD2(1, 0, 0, 34),
		BackgroundTransparency = 1,
		LayoutOrder = self._tabOrder,
		BorderSizePixel = 0,
		Selectable = false,
	})
	Bind(button, { BackgroundColor3 = "Element" })
	Corner(button, 8)

	local bar = Add("Frame", {
		Parent = button,
		Name = "Bar",
		AnchorPoint = V2(0, 0.5),
		Position = UD2(0, 0, 0.5, 0),
		Size = UFO(3, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	Round(bar)
	AccentFill(bar)

	local iconImage
	if icon then
		iconImage = Add("ImageLabel", {
			Parent = button,
			Name = "Icon",
			AnchorPoint = V2(0, 0.5),
			Position = UD2(0, 12, 0.5, 0),
			Size = UFO(16, 16),
			BackgroundTransparency = 1,
			Image = icon,
			ScaleType = SCL.Fit,
			BorderSizePixel = 0,
		})
		Bind(iconImage, { ImageColor3 = "SubText" })
	end

	local label = Text(button, {
		Name = "Label",
		Text = name,
		ColorKey = "SubText",
		Position = UFO(icon and 36 or 14, 0),
		Size = UD2(1, -(icon and 44 or 22), 1, 0),
		TextXAlignment = TXA.Left,
		TextTruncate = ETT.AtEnd,
	})

	local page: any = setmetatable({
		Name = name,
		Instance = frame,
		Left = left,
		Right = right,
		Button = button,
		Window = self,
	}, Page)

	local function setActive(active: boolean, animate: boolean?)
		local info = animate == false and TI(0) or Anim.Base
		Tween(button, info, { BackgroundTransparency = active and 0 or 1 })
		Tween(bar, info, {
			BackgroundTransparency = active and 0 or 1,
			Size = active and UFO(3, 16) or UFO(3, 0),
		})
		Tween(label, info, { TextColor3 = active and Callisto.Theme.Text or Callisto.Theme.SubText })
		if iconImage then
			Tween(iconImage, info, { ImageColor3 = active and Callisto.Theme.Accent or Callisto.Theme.SubText })
		end
	end
	page.SetActive = setActive

	Connect(button.MouseButton1Click, function()
		self:SelectPage(page)
	end)

	Hover(button, function(hovering)
		if self.CurrentPage == page then
			return
		end
		Tween(button, Anim.Fast, { BackgroundTransparency = hovering and 0.6 or 1 })
		Tween(label, Anim.Fast, { TextColor3 = hovering and Callisto.Theme.Text or Callisto.Theme.SubText })
	end)

	setActive(false, false)
	TIS(self.PageList, page)

	if not self.CurrentPage then
		self:SelectPage(page)
	end

	return page
end

function Window:SelectPage(page: any)
	if self.CurrentPage == page then
		return
	end

	self:CloseFloating()

	local previous: any = self.CurrentPage
	self.CurrentPage = page

	for _, other in next, self.PageList do
		other.SetActive(other == page)
	end

	if previous then
		previous.Instance.Visible = false
	end

	self.PageTitle.Text = page.Name

	local frame = page.Instance
	frame.Position = UFO(0, 10)
	frame.GroupTransparency = 1
	frame.Visible = true
	Tween(frame, Anim.Slow, { Position = UFO(0, 0), GroupTransparency = 0 })
end

function Window:SetTitle(title: string)
	self.Title.Text = title
end

function Window:Toggle(state: boolean?)
	local open = state
	if open == nil then
		open = not self.Visible
	end
	if open == self.Visible then
		return
	end
	self.Visible = open
	self:CloseFloating()

	local canvas = self.Canvas
	if open then
		self.ScreenGui.Enabled = true
		canvas.Visible = true
		Tween(canvas, Anim.Base, { GroupTransparency = 0 })
	else
		local tween = Tween(canvas, Anim.Base, { GroupTransparency = 1 })
		tween.Completed:Once(function()
			if not self.Visible then
				self.ScreenGui.Enabled = false
			end
		end)
	end
end

function Window:Destroy()
	local index = TF(Callisto.Windows, self)
	if index then
		TR(Callisto.Windows, index)
	end
	self:CloseFloating()
	self.ScreenGui:Destroy()
end

