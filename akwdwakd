--=============================================================================
-- Configs
--=============================================================================

function Callisto:GetConfig(): { [string]: any }
	local data = {}
	for flag, entry in next, self.Registry do
		local ok, first, second = pcall(entry.Element.Get, entry.Element)
		if ok and first ~= nil then
			if entry.Type == "Colorpickers" then
				data[flag] = { first.R, first.G, first.B, second or 0 }
			elseif entry.Type == "Keybinds" then
				data[flag] = first.Name
			else
				data[flag] = first
			end
		end
	end
	return data
end

function Callisto:SetConfig(data: { [string]: any })
	for flag, value in next, data do
		local entry = self.Registry[flag]
		if entry then
			pcall(function()
				if entry.Type == "Colorpickers" then
					entry.Element:Set(Color3.new(value[1], value[2], value[3]), value[4])
				elseif entry.Type == "Keybinds" then
					entry.Element:Set(EKC[value])
				else
					entry.Element:Set(value)
				end
			end)
		end
	end
end

function Callisto:ExportConfig(): string
	return HttpService:JSONEncode(self:GetConfig())
end

function Callisto:ImportConfig(json: string): boolean
	local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
	if not ok or type(data) ~= "table" then
		return false
	end
	self:SetConfig(data)
	return true
end

-- File helpers (only work where the environment exposes file functions)
local function FileApi()
	local env = getfenv() :: any
	return env.writefile, env.readfile, env.isfile, env.isfolder, env.makefolder, env.listfiles
end

function Callisto:SaveConfig(name: string): boolean
	local writefile, _, _, isfolder, makefolder = FileApi()
	if not writefile then
		return false
	end
	if isfolder and makefolder and not isfolder(self.ConfigFolder) then
		makefolder(self.ConfigFolder)
	end
	return pcall(writefile, ("%s/%s.json"):format(self.ConfigFolder, name), self:ExportConfig())
end

function Callisto:LoadConfig(name: string): boolean
	local _, readfile, isfile = FileApi()
	local path = ("%s/%s.json"):format(self.ConfigFolder, name)
	if not readfile or (isfile and not isfile(path)) then
		return false
	end
	local ok, contents = pcall(readfile, path)
	return ok and self:ImportConfig(contents)
end

function Callisto:ListConfigs(): { string }
	local _, _, _, isfolder, _, listfiles = FileApi()
	local names = {}
	if listfiles and isfolder and isfolder(self.ConfigFolder) then
		for _, path in ipairs(listfiles(self.ConfigFolder)) do
			local name = tostring(path):match("([^/\\]+)%.json$")
			if name then
				TIS(names, name)
			end
		end
	end
	return names
end

--=============================================================================
-- Unload
--=============================================================================

function Callisto:Unload()
	if ThemeTransition then
		ThemeTransition:Disconnect()
		ThemeTransition = nil
	end

	for _, window in next, self.Windows do
		pcall(function()
			window:CloseFloating()
		end)
	end

	for _, connection in next, self.Connections do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(self.Connections)

	for index = #self.Windows, 1, -1 do
		pcall(function()
			self.Windows[index].ScreenGui:Destroy()
		end)
		self.Windows[index] = nil
	end

	if self._root then
		self._root:Destroy()
		self._root = nil
	end
	Notifier = nil

	table.clear(ColorRegistry)
	table.clear(GradientRegistry)
	table.clear(self.Registry)
	table.clear(FlagCounts)
	table.clear(self.Flags)
end

