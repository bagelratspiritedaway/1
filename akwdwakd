		BorderSizePixel = 0,
	})
	Bind(button, { BackgroundColor3 = "Element" })
	Corner(button, 8)
	local stroke = Stroke(button, "Border")

	local display = Text(button, {
		Name = "Display",
		Text = "",
		Position = UFO(10, 0),
		Size = UD2(1, -34, 1, 0),
		TextXAlignment = TXA.Left,
		TextTruncate = ETT.AtEnd,
	})

	local icon = Add("ImageLabel", {
		Parent = button,
		Name = "Arrow",
		AnchorPoint = V2(0.5, 0.5),
		Position = UD2(1, -16, 0.5, 0),
		Size = UFO(10, 10),
		BackgroundTransparency = 1,
		Image = ICON_ARROW,
		ScaleType = SCL.Fit,
		ResampleMode = RSM.Pixelated,
		BorderSizePixel = 0,
	})
	Bind(icon, { ImageColor3 = "SubText" })

	local popup = Popup(self.Window.Externals, "Dropdown")
	Padding(popup, 4, 4, 4, 4)

	local inner = Add("ScrollingFrame", {
		Parent = popup,
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		CanvasSize = UFS(0, 0),
		AutomaticCanvasSize = AT.Y,
		ScrollBarThickness = 0,
		BorderSizePixel = 0,
		Selectable = false,
	})

	local ENTRY_HEIGHT, ENTRY_GAP = 26, 2
	List(inner, { Padding = UD(0, ENTRY_GAP) })

	local entries: { any } = {}

	local function render()
		if #selected == 0 then
			display.Text = options.Placeholder or "Select..."
			display.TextColor3 = Callisto.Theme.SubText
		else
			display.Text = table.concat(selected, ", ")
			display.TextColor3 = Callisto.Theme.Text
		end

		for _, entry in next, entries do
			local isSelected = TF(selected, entry.Value) ~= nil
			entry.Selected = isSelected
			Tween(entry.Button, Anim.Fast, {
				BackgroundTransparency = isSelected and 0 or 1,
				TextColor3 = isSelected and Callisto.Theme.Accent or Callisto.Theme.Text,
			})
		end

		if options.Flag then
			Callisto.Flags[options.Flag] = multi and table.clone(selected) or selected[1]
		end
	end

	local controller = Floating(self.Window, button, popup, function()
		return MR(button.AbsoluteSize.X)
	end, function()
		local count = #entries
		local contentHeight = count * ENTRY_HEIGHT + math.max(count - 1, 0) * ENTRY_GAP
		return math.min(contentHeight + 8, options.MaxHeight or 180)
	end, false, function(open)
		Tween(icon, Anim.Slow, { Rotation = open and 180 or 0 })
		Tween(stroke, Anim.Base, { Color = open and Callisto.Theme.Accent or Callisto.Theme.Border })
	end)

	local function AddOption(value: string)
		local entry = Text(inner, {
			ClassName = "TextButton",
			Name = "Option",
			LayoutOrder = 1,
			Text = value,
			AutoButtonColor = false,
			Size = UD2(1, 0, 0, ENTRY_HEIGHT),
			TextXAlignment = TXA.Left,
			TextTruncate = ETT.AtEnd,
			BackgroundTransparency = 1,
		})
		Bind(entry, { BackgroundColor3 = "Element" })
		Corner(entry, 6)
		Padding(entry, 0, 0, 10, 10)

		local record = { Button = entry, Value = value, Selected = false }

		Connect(entry.MouseButton1Click, function()
			local index = TF(selected, value)
			if multi then
				if index then
					TR(selected, index)
				else
					TIS(selected, value)
				end
			else
				selected = { value }
				controller.SetOpen(false)
			end
			render()
			if options.Callback then
				task.spawn(options.Callback, multi and table.clone(selected) or selected[1])
			end
		end)

		Hover(entry, function(hovering)
			if record.Selected then
				return
			end
			Tween(entry, Anim.Fast, { BackgroundTransparency = hovering and 0.5 or 1 })
		end)

		TIS(entries, record)
	end

	for _, value in ipairs(values) do
		AddOption(tostring(value))
	end

	Connect(button.MouseButton1Click, controller.Toggle)

	Hover(button, function(hovering)
		if controller.Open then
			return
		end
		Tween(stroke, Anim.Base, { Color = hovering and Callisto.Theme.Accent or Callisto.Theme.Border })
	end)

	render()

	return {
		Instance = container,
		Get = function()
			return multi and table.clone(selected) or selected[1]
		end,
		Set = function(_, value)
			selected = typeof(value) == "table" and table.clone(value) or { value }
			render()
		end,
		Refresh = function(_, newValues: { string })
			for _, entry in next, entries do
				entry.Button:Destroy()
			end
			table.clear(entries)
			selected = {}
			for _, value in ipairs(newValues) do
				AddOption(tostring(value))
			end
			render()
		end,
		Close = function()
			controller.SetOpen(false)
		end,
	}
end

-- Segmented control with a sliding indicator
function Section:AddSwitch(options: { [string]: any })
	local values = options.Values or {}
	local count = math.max(#values, 1)
	local index = options.Default or 1

	local container = Add("Frame", {
		Parent = self.Content,
		Name = "Segmented",
		Size = UD2(1, 0, 0, 32),
		BorderSizePixel = 0,
		LayoutOrder = self:_Order(),
	})
	Bind(container, { BackgroundColor3 = "Element" })
	Corner(container, 8)
	Stroke(container, "Border")
	Padding(container, 3, 3, 3, 3)

	local indicator = Add("Frame", {
		Parent = container,
		Name = "Indicator",
		Size = UD2(1 / count, 0, 1, 0),
		BorderSizePixel = 0,
	})
	Corner(indicator, 6)
	AccentFill(indicator)

	local buttons: { any } = {}

	local function titleOf(value)
		return typeof(value) == "table" and value.Title or tostring(value)
	end

	local function render(animate: boolean?)
		local info = animate == false and TI(0) or Anim.Slow
		Tween(indicator, info, { Position = UD2((index - 1) / count, 0, 0, 0) })
		for position, entry in next, buttons do
			Tween(entry.Label, animate == false and TI(0) or Anim.Base, {
				TextColor3 = entry.Disabled and Callisto.Theme.SubText
					or (position == index and WHITE or Callisto.Theme.SubText),
				TextTransparency = entry.Disabled and 0.6 or 0,
			})
		end
	end

	for position, value in ipairs(values) do
		local disabled = typeof(value) == "table" and value.Disabled or false
		local title = titleOf(value)

		local button = Add("TextButton", {
			Parent = container,
			Name = "Segment",
			Text = "",
			AutoButtonColor = false,
			BackgroundTransparency = 1,
			Position = UD2((position - 1) / count, 0, 0, 0),
			Size = UD2(1 / count, 0, 1, 0),
			BorderSizePixel = 0,
			ZIndex = 2,
		})
		local label = Text(button, {
			Name = "Label",
			Text = title,
			Size = UFS(1, 1),
			TextSize = 12,
			TextTruncate = ETT.AtEnd,
			ZIndex = 3,
		})

		TIS(buttons, { Button = button, Label = label, Disabled = disabled })

		if not disabled then
			Connect(button.MouseButton1Click, function()
				if index == position then
					return
				end
				index = position
				render()
				if options.Flag then
					Callisto.Flags[options.Flag] = title
				end
				if options.Callback then
					task.spawn(options.Callback, title, position)
				end
			end)
		end
	end

	if options.Flag then
		Callisto.Flags[options.Flag] = titleOf(values[index])
	end

	render(false)

	return {
		Instance = container,
		Get = function()
			return titleOf(values[index]), index
		end,
		Set = function(_, target)
			if type(target) == "string" then
				for position, value in ipairs(values) do
					if titleOf(value) == target then
						target = position
						break
					end
				end
			end
			if type(target) == "number" and values[target] then
				index = target
				render()
				if options.Flag then
					Callisto.Flags[options.Flag] = titleOf(values[index])
				end
			end
		end,
	}
end

Section.AddSegmented = Section.AddSwitch

--=============================================================================
-- Auto flags + registry: every element is saved automatically.
-- If you don't pass a Flag, one is generated from Page_Section_Title.
-- Pass `Save = false` in an element's options to exclude it from configs.
--=============================================================================

local FlagCounts: { [string]: number } = {}

local AutoMethods = {
	AddToggle = "Toggles",
	AddCheckbox = "Checkboxes",
	AddSlider = "Sliders",
	AddDropdown = "Dropdowns",
	AddColorpicker = "Colorpickers",
	AddKeybind = "Keybinds",
	AddInput = "Inputs",
	AddSwitch = "Segments",
}

for method, kind in next, AutoMethods do
	local original = Section[method]
	Section[method] = function(self, options, ...)
		if type(options) == "table" and options.Flag == nil and options.Save ~= false then
			local base = table.concat({
				tostring(self.PageName or "Page"),
				tostring(self.SectionTitle or "Section"),
				tostring(options.Title or kind),
			}, "_")
			FlagCounts[base] = (FlagCounts[base] or 0) + 1
			options.Flag = FlagCounts[base] > 1 and (base .. "_" .. FlagCounts[base]) or base
		end

		local element = original(self, options, ...)

		local flag = type(options) == "table" and options.Flag or nil
		if flag and type(element) == "table" then
			Callisto.Registry[flag] = { Element = element, Type = kind }
			if Callisto.Flags[flag] == nil and type(element.Get) == "function" then
				local ok, value = pcall(element.Get, element)
				if ok and value ~= nil then
					Callisto.Flags[flag] = value
				end
			end
		end

		return element
	end
end
Section.AddSegmented = Section.AddSwitch

