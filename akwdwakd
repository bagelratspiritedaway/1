local function MakeToggle(parent: Instance, default: boolean, callback: (boolean) -> ())
	local state = default and true or false

	local button = Add("TextButton", {
		Parent = parent,
		Name = "Toggle",
		Text = "",
		AutoButtonColor = false,
		Size = UFO(38, 20),
		LayoutOrder = 2,
		BorderSizePixel = 0,
	})
	Bind(button, { BackgroundColor3 = "Element" })
	Round(button)
	local stroke = Stroke(button, "Border")

	local fill = Add("Frame", {
		Parent = button,
		Name = "Fill",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		BorderSizePixel = 0,
	})
	Round(fill)
	AccentFill(fill)

	local knob = Add("Frame", {
		Parent = button,
		Name = "Knob",
		AnchorPoint = V2(0, 0.5),
		Position = UD2(0, 3, 0.5, 0),
		Size = UFO(14, 14),
		BackgroundColor3 = RGB(150, 155, 172),
		BorderSizePixel = 0,
		ZIndex = 3,
	})
	Round(knob)

	local function render(animate: boolean?)
		local info = animate == false and TI(0) or Anim.Base
		Tween(fill, info, { BackgroundTransparency = state and 0 or 1 })
		Tween(stroke, info, { Transparency = state and 1 or 0 })
		Tween(knob, animate == false and TI(0) or (state and Anim.Spring or Anim.Base), {
			Position = state and UD2(1, -17, 0.5, 0) or UD2(0, 3, 0.5, 0),
			BackgroundColor3 = state and WHITE or RGB(150, 155, 172),
		})
	end

	render(false)

	Connect(button.MouseButton1Click, function()
		state = not state
		render()
		task.spawn(callback, state)
	end)

	return {
		Instance = button,
		Get = function()
			return state
		end,
		Set = function(_, value: boolean)
			state = value and true or false
			render()
			task.spawn(callback, state)
		end,
	}
end

local function MakeCheckbox(parent: Instance, default: boolean, callback: (boolean) -> ())
	local state = default and true or false

	local button = Add("TextButton", {
		Parent = parent,
		Name = "Checkbox",
		Text = "",
		AutoButtonColor = false,
		Size = UFO(20, 20),
		LayoutOrder = 2,
		BorderSizePixel = 0,
	})
	Bind(button, { BackgroundColor3 = "Element" })
	Corner(button, 6)
	local stroke = Stroke(button, "Border")

	local fill = Add("Frame", {
		Parent = button,
		Name = "Fill",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		BorderSizePixel = 0,
	})
	Corner(fill, 6)
	AccentFill(fill)

	local icon = Add("ImageLabel", {
		Parent = button,
		Name = "Check",
		AnchorPoint = V2(0.5, 0.5),
		Position = UFS(0.5, 0.5),
		Size = UFO(6, 6),
		BackgroundTransparency = 1,
		Image = ICON_CHECK,
		ImageColor3 = WHITE,
		ImageTransparency = 1,
		ScaleType = SCL.Fit,
		ZIndex = 2,
		BorderSizePixel = 0,
	})

	local function render(animate: boolean?)
		local info = animate == false and TI(0) or Anim.Base
		Tween(fill, info, { BackgroundTransparency = state and 0 or 1 })
		Tween(stroke, info, { Transparency = state and 1 or 0 })
		Tween(icon, info, { ImageTransparency = state and 0 or 1 })
		Tween(icon, animate == false and TI(0) or (state and Anim.Spring or Anim.Fast), {
			Size = state and UFO(12, 12) or UFO(6, 6),
		})
	end

	render(false)

	Connect(button.MouseButton1Click, function()
		state = not state
		render()
		task.spawn(callback, state)
	end)

	return {
		Instance = button,
		Get = function()
			return state
		end,
		Set = function(_, value: boolean)
			state = value and true or false
			render()
			task.spawn(callback, state)
		end,
	}
end

