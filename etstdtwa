local SubElement = {}

-- Rounded tick box (default toggle style)
function SubElement.Checkbox(parent: Instance, default: boolean, callback: (boolean) -> ())
	local state = default and true or false

	local button = Add("TextButton", {
		Parent = parent,
		Text = "",
		AutoButtonColor = false,
		Name = "Checkbox",
		Size = UFO(18, 18),
		BorderSizePixel = 0,
	})
	Corner(button, 5)
	Bind(button, { BackgroundColor3 = "Element" })
	local outerStroke = Stroke(button, "Border")

	local fill = Add("Frame", {
		Parent = button,
		Name = "Fill",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		BorderSizePixel = 0,
	})
	Corner(fill, 5)
	AccentFill(fill, 45)

	local icon = Add("ImageLabel", {
		Parent = button,
		ScaleType = SCL.Fit,
		Name = "Icon",
		AnchorPoint = V2(0.5, 0.5),
		Image = ICON_CHECK,
		BackgroundTransparency = 1,
		ImageTransparency = 1,
		Rotation = -45,
		Position = UFS(0.5, 0.5),
		Size = UFO(10, 10),
		ZIndex = 2,
		BorderSizePixel = 0,
	})

	local function render(animate: boolean?)
		local info = animate == false and TI(0) or Anim.Base
		Tween(fill, info, { BackgroundTransparency = state and 0 or 1 })
		Tween(outerStroke, info, { Transparency = state and 1 or 0 })
		Tween(icon, info, { ImageTransparency = state and 0 or 1 })
		Tween(icon, animate == false and TI(0) or (state and Anim.Spring or Anim.Fast), {
			Rotation = state and 0 or -45,
		})
	end

	render(false)

	Connect(button.MouseButton1Click, function()
		state = not state
		render()
		task.spawn(callback, state)
	end)

	return {
		Instance = button,
		Get = function()
			return state
		end,
		Set = function(_, value: boolean)
			state = value and true or false
			render()
			task.spawn(callback, state)
		end,
	}
end

-- Pill switch (opt-in with Style = "Switch")
function SubElement.Switch(parent: Instance, default: boolean, callback: (boolean) -> ())
	local state = default and true or false

	local button = Add("TextButton", {
		Parent = parent,
		Text = "",
		AutoButtonColor = false,
		Name = "Switch",
		Size = UFO(30, 16),
		BorderSizePixel = 0,
	})
	Circle(button)
	Bind(button, { BackgroundColor3 = "Element" })
	local outerStroke = Stroke(button, "Border")

	local fill = Add("Frame", {
		Parent = button,
		Name = "Fill",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		BorderSizePixel = 0,
	})
	Circle(fill)
	AccentFill(fill)

	local knob = Add("Frame", {
		Parent = button,
		AnchorPoint = V2(0, 0.5),
		Name = "Knob",
		Position = UD2(0, 3, 0.5, 0),
		Size = UFO(10, 10),
		ZIndex = 2,
		BorderSizePixel = 0,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 0.5,
	})
	Circle(knob)

	local function render(animate: boolean?)
		local info = animate == false and TI(0) or Anim.Base
		Tween(fill, info, { BackgroundTransparency = state and 0 or 1 })
		Tween(outerStroke, info, { Transparency = state and 1 or 0 })
		Tween(knob, animate == false and TI(0) or (state and Anim.Spring or Anim.Base), {
			Position = state and UD2(1, -13, 0.5, 0) or UD2(0, 3, 0.5, 0),
			BackgroundTransparency = state and 0 or 0.5,
		})
	end

	render(false)

	Connect(button.MouseButton1Click, function()
		state = not state
		render()
		task.spawn(callback, state)
	end)

	return {
		Instance = button,
		Get = function()
			return state
		end,
		Set = function(_, value: boolean)
			state = value and true or false
			render()
			task.spawn(callback, state)
		end,
	}
end

