			end)
			if ok and avatar.Parent then
				avatar.Image = image
			end
		end)
	end

	local userName = opts.User
		or (LocalPlayer and (LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")"))
		or "Player"
	Text(footer, {
		Name = "User",
		Text = userName,
		Position = UFO(32, 0),
		Size = UD2(1, -32, 0, 24),
		TextXAlignment = TXA.Left,
		TextTruncate = ETT.AtEnd,
		TextSize = 12,
	})

	local subtitle = Text(footer, {
		Name = "Subtitle",
		Text = opts.Subtitle or "",
		TextColor3 = "Muted",
		Position = UFO(0, 30),
		Size = UD2(1, 0, 0, 14),
		TextXAlignment = TXA.Left,
		TextTruncate = ETT.AtEnd,
		TextSize = 11,
	})

	----------------------------------------------------------------------
	-- Main panel
	----------------------------------------------------------------------
	local panel = Add("Frame", {
		Parent = canvas,
		Name = "Panel",
		Position = UD2(0, SIDEBAR, 0, 10),
		Size = UD2(1, -(SIDEBAR + 10), 1, -20),
		BorderSizePixel = 0,
	})
	Corner(panel, 10)
	Bind(panel, { BackgroundColor3 = "Panel" })
	Stroke(panel, "Border")

	local pages = Add("Frame", {
		Parent = panel,
		Name = "Pages",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		ClipsDescendants = true,
		BorderSizePixel = 0,
	})
	Padding(pages, 14, 14, 14, 14)

	local dragTop = Add("Frame", {
		Parent = canvas,
		Name = "DragTop",
		BackgroundTransparency = 1,
		Position = UFO(SIDEBAR, 0),
		Size = UD2(1, -SIDEBAR, 0, 10),
		BorderSizePixel = 0,
	})

	local resize = Add("ImageButton", {
		Parent = canvas,
		ScaleType = SCL.Fit,
		ImageTransparency = 0.5,
		Name = "Resize",
		AnchorPoint = V2(1, 1),
		Image = ICON_RESIZE,
		BackgroundTransparency = 1,
		Position = UD2(1, -5, 1, -5),
		Size = UFO(10, 10),
		BorderSizePixel = 0,
		ZIndex = 5,
	})
	Hover(resize, function(hovering)
		Tween(resize, Anim.Fast, { ImageTransparency = hovering and 0 or 0.5 })
	end)

	local externals = Add("Frame", {
		Parent = screenGui,
		Name = "Externals",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		ZIndex = 100,
		BorderSizePixel = 0,
	})

	local window: any = setmetatable({
		Root = root,
		ScreenGui = screenGui,
		Canvas = canvas,
		Sidebar = sidebar,
		Title = title,
		Subtitle = subtitle,
		Nav = nav,
		Pages = pages,
		Externals = externals,
		PageList = {},
		CurrentPage = nil,
		Visible = true,
		HomePosition = nil,
	}, Window)

	MakeDraggable(sidebar, canvas)
	MakeDraggable(dragTop, canvas)
	MakeResizable(resize, canvas, opts.MinSize or V2(560, 400))

	local toggleKey = opts.Keybind or EKC.RightShift
	Connect(UserInputService.InputBegan, function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == UIT.Keyboard and input.KeyCode == toggleKey then
			window:Toggle()
		end
	end)

	local home = canvas.Position
	window.HomePosition = home
	canvas.Position = home + UD2(0, 0, 0, 12)
	Tween(canvas, Anim.Slow, { Position = home })

	TIS(Callisto.Windows, window)
	return window
end

function Callisto:Unload()
	if ThemeTransition then
		ThemeTransition:Disconnect()
		ThemeTransition = nil
	end

	for _, connection in next, self.Connections do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(self.Connections)

	for index = #self.Windows, 1, -1 do
		self.Windows[index].Root:Destroy()
		self.Windows[index] = nil
	end

	table.clear(ColorRegistry)
	table.clear(GradientRegistry)
	table.clear(self.Flags)
end

return Callisto
