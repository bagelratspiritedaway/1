function Section:AddButton(options: { [string]: any })
	local list = options.Buttons or { options }

	local container = Add("Frame", {
		Parent = self.Content,
		BackgroundTransparency = 1,
		Name = "Button",
		Size = UD2(1, 0, 0, 28),
		BorderSizePixel = 0,
		LayoutOrder = self:_Order(),
	})
	List(container, {
		VerticalAlignment = VFA.Center,
		FillDirection = FD.Horizontal,
		HorizontalAlignment = HFA.Center,
		HorizontalFlex = UFA.Fill,
		Padding = UD(0, 6),
	})

	local built = {}
	for index, entry in ipairs(list) do
		local button = Add("TextButton", {
			Parent = container,
			Text = "",
			AutoButtonColor = false,
			Name = "Button",
			Size = UD2(1, 0, 0, 28),
			LayoutOrder = index,
			BorderSizePixel = 0,
			ClipsDescendants = true,
		})
		Corner(button, 6)
		local stroke = Stroke(button, "Border")
		Bind(button, { BackgroundColor3 = "Element" })

		local flash = Add("Frame", {
			Parent = button,
			Name = "Flash",
			BackgroundTransparency = 1,
			Size = UFS(1, 1),
			ZIndex = 2,
			BorderSizePixel = 0,
		})
		AccentFill(flash)

		local label = Text(button, {
			Name = "Label",
			Text = entry.Title or entry.Name or "Button",
			TextColor3 = "Text",
			TextTransparency = 0.25,
			Size = UFS(1, 1),
			TextTruncate = ETT.AtEnd,
			ZIndex = 3,
		})

		Hover(button, function(hovering)
			Tween(label, Anim.Base, { TextTransparency = hovering and 0 or 0.25 })
			Tween(stroke, Anim.Base, { Color = hovering and Callisto.Theme.AccentLight or Callisto.Theme.Border })
		end)

		Connect(button.MouseButton1Click, function()
			flash.BackgroundTransparency = 0.4
			Tween(flash, Anim.Slow, { BackgroundTransparency = 1 })
			if entry.Callback then
				task.spawn(entry.Callback)
			end
		end)

		TIS(built, { Instance = button, Label = label })
	end

	return { Instance = container, Buttons = built }
end

function Section:AddLabel(options: { [string]: any } | string)
	local opts: { [string]: any } = typeof(options) == "string" and { Title = options } or (options :: any)
	local row, _, _, label = self:_Row(opts.Title or "Label")

	return {
		Instance = row,
		Set = function(_, value: string)
			label.Text = value
		end,
	}
end

function Section:AddToggle(options: { [string]: any })
	local row, left, right, label = self:_Row(options.Title or "Toggle")
	local flag = options.Flag

	local function fire(state: boolean)
		if flag then
			Callisto.Flags[flag] = state
		end
		if options.Callback then
			options.Callback(state)
		end
	end

	local control: any
	if options.Style == "Switch" then
		control = SubElement.Switch(right, options.Default or false, fire)
		control.Instance.LayoutOrder = 1
	else
		control = SubElement.Checkbox(left, options.Default or false, fire)
		control.Instance.LayoutOrder = 1
	end

	if flag then
		Callisto.Flags[flag] = options.Default or false
	end

	if options.Disabled then
		control.Instance.Interactable = false
		label.TextTransparency = 0.45
		control.Instance.BackgroundTransparency = 0.4
	end

	local window = self.Window
	control.Row = row
	control.Label = label
	control.AddKeybind = function(_, opts: { [string]: any })
		return BuildKeybind(right, opts or {}, 5)
	end
	control.AddColorpicker = function(_, opts: { [string]: any })
		return BuildColorpickerElement(right, opts or {}, window, 6)
	end
	return control
end

function Section:AddCheckbox(options: { [string]: any })
	options.Style = "Checkbox"
	return self:AddToggle(options)
end

function Section:AddColorpicker(options: { [string]: any })
	local row, _, right = self:_Row(options.Title or "Colorpicker")
	local picker = BuildColorpickerElement(right, options, self.Window, 2)
	picker.Row = row
	return picker
end

function Section:AddKeybind(options: { [string]: any })
	local row, _, right = self:_Row(options.Title or "Keybind")
	local keybind = BuildKeybind(right, options, 2)
	keybind.Row = row
	return keybind
end

function Section:AddSlider(options: { [string]: any })
	local minimum = options.Min or 0
	local maximum = options.Max or 100
	local decimals = options.Decimals or 0
	local suffix = options.Suffix or "%"
	local value = MC(options.Default or minimum, minimum, maximum)

	local container = Add("Frame", {
		Parent = self.Content,
		Name = "Slider",
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, 36),
		BorderSizePixel = 0,
		LayoutOrder = self:_Order(),
	})

	Text(container, {
		Name = "Title",
		Text = options.Title or "Slider",
		Size = UD2(0.7, 0, 0, 16),
		TextXAlignment = TXA.Left,
		TextTruncate = ETT.AtEnd,
		FontFace = FN(FONT_ID, FW.Medium, FS.Normal),
	})

	local current = Text(container, {
		Name = "Current",
		Text = "",
		AnchorPoint = V2(1, 0),
		Position = UFS(1, 0),
		Size = UD2(0.3, 0, 0, 16),
		TextXAlignment = TXA.Right,
		TextColor3 = "Muted",
		TextSize = 12,
	})

	local hit = Add("TextButton", {
		Parent = container,
		Text = "",
		AutoButtonColor = false,
		Name = "Hit",
		Position = UFO(0, 20),
		Size = UD2(1, 0, 0, 14),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})

	local track = Add("Frame", {
		Parent = hit,
		Name = "Track",
		AnchorPoint = V2(0, 0.5),
		Position = UFS(0, 0.5),
		Size = UD2(1, 0, 0, 6),
		BorderSizePixel = 0,
	})
	Circle(track)
	Bind(track, { BackgroundColor3 = "Element" })

	local fill = Add("Frame", {
		Parent = track,
		Name = "Fill",
		Size = UD2(0, 0, 1, 0),
		BorderSizePixel = 0,
	})
	Circle(fill)
	AccentFill(fill)

	local knob = Add("Frame", {
		Parent = track,
		Name = "Knob",
		Size = UFO(10, 10),
		BackgroundColor3 = WHITE,
		BorderSizePixel = 0,
		ZIndex = 2,
	})
	Circle(knob)

	local function round(number: number): number
		local multiplier = 10 ^ decimals
		return MF(number * multiplier + 0.5) / multiplier
	end

	local function render()
		local progress = (value - minimum) / (maximum - minimum)
		fill.Size = UD2(progress, 0, 1, 0)
		knob.AnchorPoint = V2(progress, 0.5)
		knob.Position = UD2(progress, 0, 0.5, 0)
		current.Text = tostring(round(value)) .. suffix
	end

	local function set(newValue: number, silent: boolean?)
		value = MC(round(newValue), minimum, maximum)
		render()
		if options.Flag then
			Callisto.Flags[options.Flag] = value
		end
		if options.Callback and not silent then
			task.spawn(options.Callback, value)
		end
	end

	local dragging = false
	local function updateFromInput(position: Vector3 | Vector2)
		local progress = MC((position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		set(minimum + (maximum - minimum) * progress)
	end

	Connect(hit.InputBegan, function(input)
		if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
			dragging = true
			updateFromInput(input.Position)
		end
	end)
	Connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
			dragging = false
		end
	end)
	Connect(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == UIT.MouseMovement or input.UserInputType == UIT.Touch) then
			updateFromInput(input.Position)
		end
	end)

	Hover(hit, function(hovering)
		Tween(knob, Anim.Fast, { Size = hovering and UFO(12, 12) or UFO(10, 10) })
	end)

	set(value, true)

	return {
		Instance = container,
		Get = function()
			return value
		end,
		Set = function(_, newValue: number)
			set(newValue)
		end,
	}
end

