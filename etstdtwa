		AutoButtonColor = false,
		Name = "Copy",
		AnchorPoint = V2(1, 0.5),
		Position = UD2(1, -8, 0.5, 0),
		Size = UFO(16, 16),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	local copyBack = Add("Frame", {
		Parent = copy,
		Position = UFO(1, 4),
		Size = UFO(9, 10),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
	})
	Corner(copyBack, 2)
	Stroke(copyBack, "Muted")
	local copyFront = Add("Frame", {
		Parent = copy,
		Position = UFO(5, 1),
		Size = UFO(9, 11),
		BorderSizePixel = 0,
	})
	Corner(copyFront, 2)
	Bind(copyFront, { BackgroundColor3 = "Muted" })

	-- Rainbow / Fading
	local options = Add("Frame", {
		Parent = panel,
		Name = "Options",
		BackgroundTransparency = 1,
		Position = UFO(0, TRACK_H + 52),
		Size = UD2(1, 0, 0, 20),
		BorderSizePixel = 0,
	})
	List(options, { FillDirection = FD.Horizontal, VerticalAlignment = VFA.Center, Padding = UD(0, 16) })

	local function option(title: string, order: number, setter: (boolean) -> ())
		local holderFrame = Add("Frame", {
			Parent = options,
			BackgroundTransparency = 1,
			Size = UD2(0, 0, 1, 0),
			AutomaticSize = AT.X,
			LayoutOrder = order,
			BorderSizePixel = 0,
		})
		List(holderFrame, { FillDirection = FD.Horizontal, VerticalAlignment = VFA.Center, Padding = UD(0, 8) })
		local box = SubElement.Checkbox(holderFrame, false, setter)
		box.Instance.LayoutOrder = 1
		Text(holderFrame, {
			Text = title,
			LayoutOrder = 2,
			TextColor3 = "Muted",
			Size = UD2(0, 0, 1, 0),
			AutomaticSize = AT.X,
			TextSize = 12,
		})
		return box
	end

	local function render(instant: boolean?)
		local color = HSV(hue, saturation, value)
		local info = (not instant) and Anim.Fast or nil

		Apply(swatch, info, { BackgroundColor3 = color, BackgroundTransparency = alpha })
		Apply(alphaBar, info, { BackgroundColor3 = color })
		Apply(sv, info, { BackgroundColor3 = HSV(hue, 1, 1) })
		Apply(svKnob, info, { Position = UFS(saturation, 1 - value) })
		Apply(hueKnob, info, { Position = UFS(0.5, hue) })
		Apply(alphaKnob, info, { Position = UFS(0.5, alpha) })

		if not hexBox:IsFocused() then
			hexBox.Text = "#" .. color:ToHex():upper() .. string.format("%02X", MR((1 - alpha) * 255))
		end

		task.spawn(callback, color, alpha)
	end

	local function BindTrack(track: GuiObject, apply: (Vector2) -> ())
		local dragging = false

		local function update(position: Vector3 | Vector2)
			local absolutePosition = track.AbsolutePosition
			local absoluteSize = track.AbsoluteSize
			apply(V2(
				MC((position.X - absolutePosition.X) / absoluteSize.X, 0, 1),
				MC((position.Y - absolutePosition.Y) / absoluteSize.Y, 0, 1)
			))
		end

		Connect(track.InputBegan, function(input)
			if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
				dragging = true
				update(input.Position)
			end
		end)
		Connect(UserInputService.InputEnded, function(input)
			if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
				dragging = false
			end
		end)
		Connect(UserInputService.InputChanged, function(input)
			if not dragging then
				return
			end
			if input.UserInputType == UIT.MouseMovement or input.UserInputType == UIT.Touch then
				update(input.Position)
			end
		end)
	end

	-- the SV square has no input of its own, so catch input on the frame
	sv.Active = true
	BindTrack(sv, function(position)
		saturation = position.X
		value = 1 - position.Y
		render(true)
	end)
	BindTrack(hueBar, function(position)
		hue = position.Y
		render(true)
	end)
	BindTrack(alphaBar, function(position)
		alpha = position.Y
		render(true)
	end)

	Connect(hexBox.FocusLost, function()
		local raw = hexBox.Text:gsub("#", ""):gsub("%s", "")
		if #raw == 6 or #raw == 8 then
			local ok, color = pcall(Color3.fromHex, raw:sub(1, 6))
			if ok and color then
				hue, saturation, value = color:ToHSV()
				if #raw == 8 then
					local a = tonumber(raw:sub(7, 8), 16)
					if a then
						alpha = 1 - a / 255
					end
				end
			end
		end
		render()
	end)

	Connect(copy.MouseButton1Click, function()
		local ok, fn = pcall(function()
			return (getfenv() :: any).setclipboard
		end)
		if ok and fn then
			pcall(fn, hexBox.Text)
		end
	end)

	option("Rainbow", 1, function(state)
		rainbow = state
	end)
	option("Fading", 2, function(state)
		fading = state
	end)

	Connect(RunService.RenderStepped, function(dt)
		if not (rainbow or fading) then
			return
		end
		if rainbow then
			hue = (hue + dt * 0.2) % 1
		end
		if fading then
			alpha = (math.sin(os.clock() * 2) * 0.5 + 0.5) * 0.85
		end
		render(true)
	end)

	local open = false
	local basePosition = UFO(0, 0)

	local function setOpen(shouldOpen: boolean)
		if open == shouldOpen then
			return
		end
		open = shouldOpen

		if open then
			local sp, ss = swatch.AbsolutePosition, swatch.AbsoluteSize
			local screen = (holder :: any).AbsoluteSize
			local x = MC(sp.X + ss.X - PW, 4, math.max(4, screen.X - PW - 4))
			local y = sp.Y + ss.Y + 6
			if y + PH > screen.Y - 4 then
				y = sp.Y - PH - 6
			end
			basePosition = ToHolderSpace(holder, x, y)
		end
		AnimatePopup(panel, open, basePosition)
	end

	Connect(swatch.MouseButton1Click, function()
		setOpen(not open)
	end)

	Connect(UserInputService.InputBegan, function(input)
		if not open then
			return
		end
		if input.UserInputType ~= UIT.MouseButton1 and input.UserInputType ~= UIT.Touch then
			return
		end
		local mouse = V2(input.Position.X, input.Position.Y)
		if not InsideBounds(mouse, panel) and not InsideBounds(mouse, swatch) then
			setOpen(false)
		end
	end)

	render(true)

	return {
		Panel = panel,
		Close = function()
			setOpen(false)
		end,
		Get = function()
			return HSV(hue, saturation, value), alpha
		end,
		Set = function(_, color: Color3, newAlpha: number?)
			hue, saturation, value = color:ToHSV()
			alpha = newAlpha or alpha
			render()
		end,
	}
end

-- Colour swatch that can live in any row's right-hand container.
local function BuildColorpickerElement(parent: Instance, options: { [string]: any }, window: any, order: number?)
	local flag = options.Flag

	local swatch = Add("TextButton", {
		Parent = parent,
		Text = "",
		AutoButtonColor = false,
		Name = "Colorpicker",
		Size = UFO(20, 20),
		LayoutOrder = order or 2,
		BorderSizePixel = 0,
	})
	swatch.BackgroundColor3 = options.Default or Callisto.Theme.Accent
	Corner(swatch, 6)

	local swatchStroke = Add("UIStroke", {
		Parent = swatch,
		Transparency = 1,
		Thickness = 1.5,
		ApplyStrokeMode = ASM.Border,
	})
	Bind(swatchStroke, { Color = "Text" })

	Hover(swatch, function(hovering)
		Tween(swatchStroke, Anim.Fast, { Transparency = hovering and 0.7 or 1 })
	end)

	if flag then
		Callisto.Flags[flag] = options.Default or Callisto.Theme.Accent
	end

	local picker: any = BuildColorpicker(
		window.Externals,
		swatch,
		options.Default or Callisto.Theme.Accent,
		options.Alpha or 0,
		function(color, alpha)
			if flag then
				Callisto.Flags[flag] = color
			end
			if options.Callback then
				options.Callback(color, alpha)
			end
		end
	)

	picker.Instance = swatch
	return picker
end

-- Key box that can live in any row's right-hand container.
local function BuildKeybind(parent: Instance, options: { [string]: any }, order: number?)
	local current: EnumItem? = options.Default
	local binding = false

	local box = Add("Frame", {
		Parent = parent,
		LayoutOrder = order or 2,
		Name = "Keybind",
		Size = UFO(0, 20),
		AutomaticSize = AT.X,
		BorderSizePixel = 0,
	})
	Corner(box, 5)
	local stroke = Stroke(box, "Border")
	Bind(box, { BackgroundColor3 = "Element" })

	local button = Text(box, {
		ClassName = "TextButton",
		Active = true,
		Selectable = false,
		Name = "Key",
		Text = KeyName(current),
		TextColor3 = "Muted",
		TextSize = 11,
		Size = UD2(0, 0, 1, 0),
		AutomaticSize = AT.X,
		AutoButtonColor = false,
	})
	Padding(button, 0, 0, 8, 8)

	local function render()
		button.Text = binding and "..." or KeyName(current)
		Tween(button, Anim.Fast, { TextColor3 = binding and Callisto.Theme.Text or Callisto.Theme.Muted })
		Tween(stroke, Anim.Fast, { Color = binding and Callisto.Theme.Accent or Callisto.Theme.Border })
	end

	Connect(button.MouseButton1Click, function()
		binding = true
		render()
	end)

	Hover(box, function(hovering)
		if binding then
			return
		end
		Tween(stroke, Anim.Fast, { Color = hovering and Callisto.Theme.AccentLight or Callisto.Theme.Border })
	end)

	if options.Flag then
		Callisto.Flags[options.Flag] = current
	end

	Connect(UserInputService.InputBegan, function(input, processed)
		if binding then
			if input.UserInputType == UIT.Keyboard and input.KeyCode ~= EKC.Unknown then
				if input.KeyCode == EKC.Backspace then
					current = nil
				else
					current = input.KeyCode
				end
				binding = false
				render()
				if options.Flag then
					Callisto.Flags[options.Flag] = current
				end
				if options.Changed then
					task.spawn(options.Changed, current)
				end
			end
			return
		end

		if processed or not current then
			return
		end
		if input.UserInputType == UIT.Keyboard and input.KeyCode == current and options.Callback then
			task.spawn(options.Callback, current)
		end
	end)

	render()

	return {
		Instance = box,
		Get = function()
			return current
		end,
		Set = function(_, key: EnumItem?)
			current = key
			render()
		end,
	}
end

