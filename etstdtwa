-- Columns + sections
--=============================================================================

local function MakeColumns(parent: Instance, name: string)
	local frame = Add("Frame", {
		Parent = parent,
		Name = name,
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		BorderSizePixel = 0,
	})

	local function column(side: number)
		local scroller = Add("ScrollingFrame", {
			Parent = frame,
			Name = side == 0 and "Left" or "Right",
			AnchorPoint = V2(side, 0),
			Position = UFS(side, 0),
			Size = UD2(0.5, -7, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 0,
			CanvasSize = UFS(0, 0),
			AutomaticCanvasSize = AT.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			Selectable = false,
		})
		Padding(scroller, 1, 1, 1, 1)
		List(scroller, { Padding = UD(0, 14) })
		return scroller
	end

	return frame, column(0), column(1)
end

-- Builds: [icon circle][title pill] above a bordered card. Returns the Section.
local function AddSectionTo(owner: any, side: string?, title: string?, icon: string?)
	local normalized = side and side:lower() or "left"

	if normalized ~= "left" and normalized ~= "right" then
		icon = title
		title = side
		normalized = "left"
	end

	local parent = (normalized == "right") and owner.Right or owner.Left

	local wrapper = Add("Frame", {
		Parent = parent,
		Name = "Section",
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, 0),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
	})
	List(wrapper, { Padding = UD(0, 10) })

	local header = Add("Frame", {
		Parent = wrapper,
		Name = "Header",
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, 26),
		BorderSizePixel = 0,
		LayoutOrder = 1,
	})
	List(header, { FillDirection = FD.Horizontal, VerticalAlignment = VFA.Center, Padding = UD(0, 8) })

	if icon then
		local circle = Add("Frame", {
			Parent = header,
			Name = "IconHolder",
			Size = UFO(26, 26),
			BorderSizePixel = 0,
			LayoutOrder = 1,
		})
		Circle(circle)
		Bind(circle, { BackgroundColor3 = "Card" })
		Stroke(circle, "Border")
		local glyph = Icon(circle, icon, 13, "Muted")
		glyph.AnchorPoint = V2(0.5, 0.5)
		glyph.Position = UFS(0.5, 0.5)
	end

	local pill = Add("Frame", {
		Parent = header,
		Name = "Pill",
		Size = UD2(0, 0, 0, 24),
		AutomaticSize = AT.X,
		BorderSizePixel = 0,
		LayoutOrder = 2,
	})
	Circle(pill)
	Bind(pill, { BackgroundColor3 = "Card" })
	Stroke(pill, "Border")
	Padding(pill, 0, 0, 12, 12)
	Text(pill, {
		Name = "Title",
		Text = title or "Section",
		Size = UD2(0, 0, 1, 0),
		AutomaticSize = AT.X,
		TextSize = 12,
	})

	local card = Add("Frame", {
		Parent = wrapper,
		Name = "Card",
		Size = UD2(1, 0, 0, 0),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
		LayoutOrder = 2,
	})
	Corner(card, 8)
	Bind(card, { BackgroundColor3 = "Card" })
	Stroke(card, "Border")
	Padding(card, 14, 14, 14, 14)
	List(card, { Padding = UD(0, 10) })

	return setmetatable({
		Instance = wrapper,
		Content = card,
		Window = owner.Window,
		Page = owner,
		_order = 0,
	}, Section)
end

--=============================================================================
-- SubPage (top pill tabs inside a page)
--=============================================================================

local SubPage = {}
SubPage.__index = SubPage

function SubPage:AddSection(side: string?, title: string?, icon: string?)
	return AddSectionTo(self, side, title, icon)
end

--=============================================================================
-- Page
--=============================================================================

local Page = {}
Page.__index = Page

function Page:AddSection(side: string?, title: string?, icon: string?)
	return AddSectionTo(self, side, title, icon)
end

function Page:SelectSubPage(sub: any)
	if self.CurrentSub == sub then
		return
	end
	self.CurrentSub = sub

	for _, other in next, self.SubPages do
		local active = other == sub
		other.Columns.Visible = active
		Tween(other.Button, Anim.Base, { BackgroundTransparency = active and 0 or 1 })
		Tween(other.Label, Anim.Base, { TextColor3 = active and Callisto.Theme.Text or Callisto.Theme.Muted })
		if other.Glyph then
			Tween(other.Glyph, Anim.Base, { ImageColor3 = active and Callisto.Theme.AccentLight or Callisto.Theme.Muted })
		end
	end

	sub.Columns.Position = UFO(0, 6)
	Tween(sub.Columns, Anim.Slow, { Position = UFO(0, 0) })
end

function Page:AddSubPage(name: string, icon: string?)
	if #self.SubPages == 0 then
		self.Strip.Visible = true
		self.Body.Position = UFO(0, 46)
		self.Body.Size = UD2(1, 0, 1, -46)
		self.Columns.Visible = false
	end

	local columns, left, right = MakeColumns(self.Body, name)
	columns.Visible = false

	local button = Add("TextButton", {
		Parent = self.Strip,
		Text = "",
		AutoButtonColor = false,
		Name = name,
		Size = UD2(0, 0, 1, 0),
		AutomaticSize = AT.X,
		BorderSizePixel = 0,
		BackgroundTransparency = 1,
		LayoutOrder = #self.SubPages + 1,
	})
	Corner(button, 6)
	Bind(button, { BackgroundColor3 = "Element" })
	Padding(button, 0, 0, 12, 12)
	List(button, {
		FillDirection = FD.Horizontal,
		VerticalAlignment = VFA.Center,
		HorizontalAlignment = HFA.Center,
		Padding = UD(0, 7),
	})

	local glyph
	if icon then
		glyph = Icon(button, icon, 14, "Muted")
		glyph.LayoutOrder = 1
	end

	local label = Text(button, {
		Name = "Label",
		Text = name,
		LayoutOrder = 2,
		TextColor3 = "Muted",
		Size = UD2(0, 0, 1, 0),
		AutomaticSize = AT.X,
	})

	local sub: any = setmetatable({
		Name = name,
		Columns = columns,
		Left = left,
		Right = right,
		Button = button,
		Label = label,
		Glyph = glyph,
		Window = self.Window,
		Page = self,
	}, SubPage)

	Hover(button, function(hovering)
		if self.CurrentSub == sub then
			return
		end
		Tween(label, Anim.Fast, { TextColor3 = hovering and Callisto.Theme.Text or Callisto.Theme.Muted })
	end)

	Connect(button.MouseButton1Click, function()
		self:SelectSubPage(sub)
	end)

	TIS(self.SubPages, sub)
	if #self.SubPages == 1 then
		self:SelectSubPage(sub)
	end

	return sub
end

--=============================================================================
-- Window
--=============================================================================

local Window = {}
Window.__index = Window

function Window:AddPage(name: string, icon: string?)
	local frame = Add("Frame", {
		Parent = self.Pages,
		BackgroundTransparency = 1,
		Name = name,
		Size = UFS(1, 1),
		Visible = false,
		BorderSizePixel = 0,
	})

	-- Pill tab strip (only shown once a sub page is added)
	local strip = Add("Frame", {
		Parent = frame,
		Name = "Strip",
		Visible = false,
		Size = UD2(0, 0, 0, 34),
		AutomaticSize = AT.X,
		BorderSizePixel = 0,
	})
	Corner(strip, 8)
	Bind(strip, { BackgroundColor3 = "Card" })
	Stroke(strip, "Border")
	Padding(strip, 3, 3, 3, 3)
	List(strip, { FillDirection = FD.Horizontal, VerticalAlignment = VFA.Center, Padding = UD(0, 4) })

	local body = Add("Frame", {
		Parent = frame,
		Name = "Body",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		BorderSizePixel = 0,
	})
	local columns, left, right = MakeColumns(body, "Columns")

	-- Sidebar nav button
	local button = Add("TextButton", {
		Parent = self.Nav,
		Text = "",
		AutoButtonColor = false,
		Name = name,
		Size = UD2(1, 0, 0, 38),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		LayoutOrder = #self.PageList + 1,
	})
	Corner(button, 7)
	AccentFill(button, 20)

	local buttonStroke = Stroke(button, "AccentLight")
	buttonStroke.Transparency = 1

	local glyph
	local textX = 12
	if icon then
		glyph = Icon(button, icon, 16, "Muted")
		glyph.AnchorPoint = V2(0, 0.5)
		glyph.Position = UD2(0, 11, 0.5, 0)
		textX = 36
	end

	local label = Text(button, {
		Text = name,
		TextColor3 = "Muted",
		Position = UFO(textX, 0),
		Size = UD2(1, -textX, 1, 0),
		TextXAlignment = TXA.Left,
		TextTruncate = ETT.AtEnd,
	})

	local page: any = setmetatable({
		Name = name,
		Instance = frame,
		Strip = strip,
		Body = body,
		Columns = columns,
		Left = left,
		Right = right,
		Button = button,
		Window = self,
		SubPages = {},
		CurrentSub = nil,
	}, Page)

	page.SetActive = function(active: boolean, animate: boolean?)
		local info = animate == false and TI(0) or Anim.Base
		Tween(button, info, { BackgroundTransparency = active and 0 or 1 })
		Tween(buttonStroke, info, { Transparency = active and 0.45 or 1 })
		Tween(label, info, { TextColor3 = active and WHITE or Callisto.Theme.Muted })
		if glyph then
			Tween(glyph, info, { ImageColor3 = active and WHITE or Callisto.Theme.Muted })
		end
	end

	Connect(button.MouseButton1Click, function()
		self:SelectPage(page)
	end)

	Hover(button, function(hovering)
		if self.CurrentPage == page then
			return
		end
		Tween(label, Anim.Fast, { TextColor3 = hovering and Callisto.Theme.Text or Callisto.Theme.Muted })
		if glyph then
			Tween(glyph, Anim.Fast, { ImageColor3 = hovering and Callisto.Theme.Text or Callisto.Theme.Muted })
		end
	end)

	page.SetActive(false, false)
	TIS(self.PageList, page)

	if not self.CurrentPage then
		self:SelectPage(page)
	end

	return page
end

function Window:SelectPage(page: any)
	if self.CurrentPage == page then
		return
	end

	local previous: any = self.CurrentPage
	self.CurrentPage = page

	for _, other in next, self.PageList do
		other.SetActive(other == page)
	end

	if previous then
		previous.Instance.Visible = false
	end

	page.Instance.Position = UFO(0, 8)
	page.Instance.Visible = true
	Tween(page.Instance, Anim.Slow, { Position = UFO(0, 0) })
end

function Window:SetTitle(title: string)
	self.Title.Text = title
end

function Window:SetSubtitle(text: string)
	self.Subtitle.Text = text
end

function Window:Toggle(state: boolean?)
	local open = state
	if open == nil then
		open = not self.Visible
	end
	if open == self.Visible then
		return
	end
	self.Visible = open

	local canvas: any = self.Canvas

	if open then
		local home: UDim2 = self.HomePosition or canvas.Position
		self.HomePosition = home
		self.ScreenGui.Enabled = true
		canvas.Position = home + UD2(0, 0, 0, 12)
		Tween(canvas, Anim.Slow, { Position = home })
	else
		local home: UDim2 = canvas.Position
		self.HomePosition = home
		local tween = Tween(canvas, Anim.Base, { Position = home + UD2(0, 0, 0, 12) })
		tween.Completed:Once(function()
			if not self.Visible then
				self.ScreenGui.Enabled = false
				canvas.Position = home
			end
		end)
	end
end

function Window:Destroy()
	local index = TF(Callisto.Windows, self)
	if index then
		TR(Callisto.Windows, index)
	end
	self.Root:Destroy()
end

